# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─── JWT (Access Token — short-lived) ─────────────────────
JWT_SECRET="generate_with: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
JWT_EXPIRES_IN="15m"

# ─── Refresh Token (long-lived) ───────────────────────────
REFRESH_TOKEN_SECRET="generate_with: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
REFRESH_TOKEN_EXPIRES_IN="7d"

# ─── Cookie ───────────────────────────────────────────────
COOKIE_EXPIRES_IN_DAYS=7

# ─── Client URL (used to build email links) ───────────────
CLIENT_URL="http://localhost:5173"

# ─── SMTP (leave blank in dev — Ethereal auto-account is used) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RBAC App <noreply@rbac.dev>"

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=200
RATE_LIMIT_WINDOW_MINUTES=15

.env
.env.local
.env.*.local

# ─── Build output ─────────────────────────────────────────
dist/
build/

# ─── Logs ─────────────────────────────────────────────────
*.log
logs/
npm-debug.log*

# ─── Test & coverage output ───────────────────────────────
coverage/

